{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teacher Planner",
  "version": "1.0.0",
  "identifier": "gr.atzenta.teacher-planner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ατζέντα Εκπαιδευτικού",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Ατζέντα Εκπαιδευτικού",
    "category": "Education",
    "shortDescription": "Teacher planner",
    "longDescription": "Ατζέντα Εκπαιδευτικού — a teacher's planner that keeps all its data as plain files beside the app."
  }
}
